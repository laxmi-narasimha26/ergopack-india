# Database
MONGODB_URI=mongodb://localhost:27017/ergopack-india
MONGODB_DB=ergopack-india

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here-change-in-production

# Admin Credentials (Change these!)
ADMIN_EMAIL=admin@ergopack-india.com
ADMIN_PASSWORD=change-this-password

# Email Configuration (for contact form notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@ergopack-india.com
EMAIL_TO=contact@ergopack-india.com

# Resend Email API (Alternative to SMTP - recommended)
# Get API key from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Primary contact email for inquiries
CONTACT_EMAIL=sales@ergopack-india.com

# Additional notification emails (comma-separated, no spaces)
# All these emails will receive inquiry notifications
NOTIFICATION_EMAILS=manager@ergopack-india.com,support@ergopack-india.com

# =============================================================================
# File Storage (Vercel Blob)
# =============================================================================
# Get token from: Vercel Dashboard > Storage > Create Blob Store
BLOB_READ_WRITE_TOKEN=vercel_blob_xxxxxxxxxxxxxxxxxxxx


# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Optional: Analytics, etc.
# NEXT_PUBLIC_GA_ID=

# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Sentry Error Tracking
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# Vercel Deployment (for CI/CD)
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=

# =============================================================================
# Security Configuration
# =============================================================================

# Allowed Origins for CORS (comma-separated, no spaces)
# Add your production domain here
ALLOWED_ORIGINS=https://ergopack-india.com,https://www.ergopack-india.com

# Rate Limiting (optional - defaults are set in code)
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX_REQUESTS=100

# Enable honeypot protection (default: true)
ENABLE_HONEYPOT=true
